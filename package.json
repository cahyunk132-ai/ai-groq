{
  "name": "ai-groq",
  "version": "0.1.0",
  "description": "Bot Minecraft otonom: loop OODA dengan Mineflayer sebagai eksekutor dan Groq sebagai pengambil keputusan.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js test/**/*.test.js",
    "tmux:start": "bash scripts/tmux-start.sh",
    "tmux:attach": "tmux attach -t omnibot",
    "tmux:stop": "tmux kill-session -t omnibot",
    "tmux:status": "tmux ls"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.7",
    "minecraft-data": "^3.117.0",
    "mineflayer": "^4.39.0",
    "mineflayer-armor-manager": "^2.0.1",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "prismarine-schematic": "^1.3.0",
    "vec3": "^0.2.0"
  }
}
