# Groq API (wajib)
GROQ_API_KEY=isi_api_key_groq_anda
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=8000

# Server Minecraft
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=GroqBot
# offline untuk server non-premium / LAN, microsoft untuk akun resmi
MC_AUTH=offline
# MC_VERSION=1.20.4

# Loop OODA (tick ini hanya menjalankan aksi; Groq dibatasi terpisah di bawah)
LOOP_TICK_MS=3000

# Pembatas Groq untuk free tier (gpt-oss: 8000 TPM, 200K token/hari, ~3100 token per panggilan)
GROQ_DAILY_CALL_CAP=50
GROQ_PLAN_INTERVAL_MS=300000
GROQ_CHAT_INTERVAL_MS=60000
# GROQ_USAGE_FILE=.groq-usage.json
SENSE_RADIUS=16
