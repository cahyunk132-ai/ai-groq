# Groq API (wajib)
GROQ_API_KEY=isi_api_key_groq_anda
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=8000

# Server Minecraft
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=GroqBot
# offline untuk server non-premium / LAN, microsoft untuk akun resmi
MC_AUTH=offline
# MC_VERSION=1.20.4

# Loop OODA
# Free tier Groq (gpt-oss): 8000 TPM. Satu request ~3100 token (input + max_tokens),
# jadi kira-kira 1 request per 25-30 detik. Naikkan kalau pakai paket berbayar.
LOOP_TICK_MS=30000
SENSE_RADIUS=16
