# Groq API (wajib)
GROQ_API_KEY=isi_api_key_groq_anda
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=8000

# Server Minecraft
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=bot_adminv2
MC_USERNAME_2=bot_admin
# offline untuk server non-premium / LAN, microsoft untuk akun resmi
MC_AUTH=offline
# MC_VERSION=1.20.4

# Sosialisasi & Dual Bot
FRIEND_BOTS=bot_admin,bot_adminv2
INTERACT_WITH_PLAYERS=true
ENCOUNTER_RADIUS=6

# Loop OODA
LOOP_TICK_MS=3000
SENSE_RADIUS=16
